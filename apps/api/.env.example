APP_NAME="Tours Catalog"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=tours_catalog
DB_USERNAME=tours
DB_PASSWORD=change_me_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

WEB_ORIGIN=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

EMBEDDINGS_URL=http://embeddings:8000
EMBEDDINGS_TIMEOUT=3

SEARCH_TOP_K=20
SEARCH_MIN_SCORE=0.35
EMBEDDINGS_TIMEOUT=3

PHOTO_MAX_SIZE_MB=10
PHOTO_ALLOWED_MIMES=image/jpeg,image/png,image/webp

# ------------------------------------------------------------------------------
# Tours Catalog — environment template
# Copy to .env: make env
# Never commit .env or real secrets.
# ------------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=tours-catalog

# --- Host ports (published to your machine) ---
DB_PORT=5432
API_PORT=8080
WEB_PORT=3000

# --- PostgreSQL (service: db) ---
# DB_PORT is the host-published port (docker compose maps DB_PORT:5432).
DB_HOST=db
DB_DATABASE=tours_catalog
DB_USERNAME=tours
DB_PASSWORD=change_me_db_password

# Laravel database (apps/api — use 5432 inside the compose network)
DB_CONNECTION=pgsql

# --- Application URLs ---
APP_NAME="Tours Catalog"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8080
# Optional absolute base for /storage/... URLs (leave empty = relative path, works with Vite proxy)
PUBLIC_STORAGE_URL=

WEB_ORIGIN=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8080
# Browser: relative URL via Vite proxy (same origin for Sanctum CSRF). SSR uses API_INTERNAL_URL in compose.
VITE_API_BASE_URL=/api/v1
VITE_YANDEX_MAPS_API_KEY=

# --- Embeddings (internal Docker network only — not exposed on host) ---
EMBEDDINGS_URL=http://embeddings:8000
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_HOME=/var/cache/huggingface
TRANSFORMERS_CACHE=/var/cache/huggingface
# MOCK_EMBEDDINGS=1  # CI/dev: random 384-dim vectors without downloading the model

# --- Semantic search defaults ---
SEARCH_TOP_K=20
SEARCH_MIN_SCORE=0.35

# --- Yandex Maps (public + admin route editor) ---
YANDEX_MAPS_API_KEY=

# --- OpenAI-compatible LLM (admin tour draft generation) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Catalog seed (demo tours + admin; see make seed) ---
# When 1, api seeds on startup if the tours table is empty (safe to leave on in dev).
AUTO_SEED=1
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# --- Optional: Redis (future queue profile) ---
# REDIS_HOST=redis
# REDIS_PORT=6379
